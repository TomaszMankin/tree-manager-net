<Window x:Class="TreeManager.App.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktualizacja"
        Height="180" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="24,20">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="TakButton" Content="Tak" Width="90" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="TakButton_Click"/>
            <Button x:Name="NieButton" Content="Nie" Width="90"
                    IsCancel="True"
                    Click="NieButton_Click"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Dostępna aktualizacja — zainstalować?"
                       FontSize="14"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText"
                       FontSize="12"
                       Margin="0,6,0,0"
                       Foreground="Gray"/>
        </StackPanel>

    </DockPanel>
</Window>
