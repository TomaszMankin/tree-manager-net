<Window x:Class="TreeManager.App.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wystąpił błąd"
        Height="180" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="24,20">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Zamknij" Width="90"
                    IsDefault="True"
                    IsCancel="True"/>
        </StackPanel>

        <TextBlock Text="Wystąpił nieoczekiwany błąd. Szczegóły zostały zapisane w dzienniku. Spróbuj ponownie lub uruchom aplikację jeszcze raz."
                   FontSize="13"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>

    </DockPanel>
</Window>
