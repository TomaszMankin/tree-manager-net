<Window x:Class="TreeManager.App.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Niezapisane zmiany"
        Height="160" Width="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="24,20">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="TakButton" Content="Tak" Width="90" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="TakButton_Click"/>
            <Button x:Name="NieButton" Content="Nie" Width="90"
                    IsCancel="True"
                    Click="NieButton_Click"/>
        </StackPanel>

        <TextBlock Text="Masz niezapisane zmiany. Odrzucić?"
                   FontSize="14"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>

    </DockPanel>
</Window>
