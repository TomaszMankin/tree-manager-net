<Window x:Class="TreeManager.App.Views.ValidationReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sprawdź spójność drzewa"
        Height="440" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Zamknij" Width="90"
                    IsCancel="True"/>
        </StackPanel>

        <TextBlock x:Name="NoProblemsText"
                   Text="Nie znaleziono problemów."
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <ListBox x:Name="IssuesList"
                 FontSize="13"
                 Visibility="Collapsed"/>

    </DockPanel>
</Window>
