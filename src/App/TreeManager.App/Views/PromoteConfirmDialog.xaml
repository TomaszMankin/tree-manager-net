<Window x:Class="TreeManager.App.Views.PromoteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Przenieś do drzewa"
        Height="240" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="24,20">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="TakButton" Content="Tak" Width="90" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="TakButton_Click"/>
            <Button x:Name="NieButton" Content="Nie" Width="90"
                    IsCancel="True"
                    Click="NieButton_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Czy przenieść tę osobę do drzewa?"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="SummaryBlock"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </StackPanel>

    </DockPanel>
</Window>
