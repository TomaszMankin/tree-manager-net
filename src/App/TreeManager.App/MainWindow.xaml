<Window x:Class="TreeManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TreeManager.App.ViewModels"
        xmlns:views="clr-namespace:TreeManager.App.Views"
        Title="{Binding WindowTitle}"
        Height="700" Width="1040" MinHeight="600" MinWidth="860"
        FontFamily="Segoe UI">
    <DockPanel>

        <!-- Narzędzia menu — top-most, above header -->
        <Menu DockPanel.Dock="Top" Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="8,2">
            <MenuItem Header="Narzędzia">
                <MenuItem Header="Zmień folder"
                          Command="{Binding ChangeRootFolderCommand}"/>
                <MenuItem Header="Otwórz folder z danymi"
                          Command="{Binding OpenDataFolderCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Header bar — Option B layout -->
        <Border DockPanel.Dock="Top" Background="#1565C0" Padding="10,10">
            <DockPanel>

                <!-- Mode box — left -->
                <Border DockPanel.Dock="Left"
                        Background="{Binding CurrentMode, Converter={StaticResource ModeToBackgroundBrushConverter}}"
                        CornerRadius="6" Padding="14,6" Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentMode, Converter={StaticResource ModeToLabelConverter}}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="#1A237E"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Red report button — far right -->
                <Button DockPanel.Dock="Right"
                        Content="Wyślij raport o błędzie"
                        Command="{Binding SendTestReportCommand}"
                        Background="#D32F2F" Foreground="White"
                        FontSize="14" Padding="14,8" Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

                <!-- Three command groups -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- OSOBA group -->
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="OSOBA" FontSize="11" Foreground="#90CAF9"
                                   FontWeight="SemiBold" Margin="0,0,0,4"
                                   HorizontalAlignment="Center"/>
                        <WrapPanel>
                            <Button Content="Nowa osoba"
                                    Command="{Binding SwitchModeCommand}"
                                    CommandParameter="{x:Static vm:AppMode.Add}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Edytuj osobę z drzewa"
                                    Command="{Binding OpenPersonCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Zapisz osobę i dodaj do drzewa"
                                    Command="{Binding SaveNewPersonCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Zapisz zmiany dla osoby na drzewie"
                                    Command="{Binding SaveTreeChangesCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- SZKIC group -->
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="SZKIC" FontSize="11" Foreground="#90CAF9"
                                   FontWeight="SemiBold" Margin="0,0,0,4"
                                   HorizontalAlignment="Center"/>
                        <WrapPanel>
                            <Button Content="Wczytaj szkic osoby"
                                    Command="{Binding LoadDraftCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Zapisz osobę jako szkic"
                                    Command="{Binding SaveAsDraftCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Zaktualizuj szkic osoby"
                                    Command="{Binding UpdateDraftCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Dodaj szkic osoby do drzewa"
                                    Command="{Binding PromoteDraftCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- DRZEWO group -->
                    <StackPanel>
                        <TextBlock Text="DRZEWO" FontSize="11" Foreground="#90CAF9"
                                   FontWeight="SemiBold" Margin="0,0,0,4"
                                   HorizontalAlignment="Center"/>
                        <WrapPanel>
                            <Button Content="Wybierz osobę główną"
                                    Command="{Binding SetRootPersonCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Generuj Drzewo"
                                    Command="{Binding GenerateFolderTreeCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Generuj Rody"
                                    Command="{Binding GenerateLineageFoldersCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                            <Button Content="Sprawdź spójność"
                                    Command="{Binding ValidateTreeCommand}"
                                    FontSize="14" Margin="2,0" Padding="12,7"/>
                        </WrapPanel>
                    </StackPanel>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="22,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#2E7D32" FontSize="13"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C62828" FontSize="13"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Mode-tinted content area -->
        <Grid Background="{Binding CurrentMode, Converter={StaticResource ModeToBackgroundBrushConverter}}">
            <TabControl Margin="0" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                <TabItem Header="1.  Dane osoby">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <views:PersonDataTab DataContext="{Binding Person}"/>
                            <Separator Margin="32,0" Background="#E0E0E0"/>
                            <views:DatesTab DataContext="{Binding Dates}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="2.  Rodzina">
                    <views:FamilyTab DataContext="{Binding Family}"/>
                </TabItem>
                <TabItem Header="3.  Notatki">
                    <views:NotesTab DataContext="{Binding Notes}"/>
                </TabItem>
            </TabControl>
        </Grid>

    </DockPanel>
</Window>
