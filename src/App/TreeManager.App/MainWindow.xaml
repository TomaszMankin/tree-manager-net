<Window x:Class="TreeManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TreeManager.App.ViewModels"
        xmlns:views="clr-namespace:TreeManager.App.Views"
        Title="{Binding WindowTitle}"
        Height="700" Width="1040" MinHeight="600" MinWidth="860"
        FontFamily="Segoe UI">
    <DockPanel>

        <!-- Top menu bar — Narzędzia / OSOBA / SZKIC / DRZEWO + report button far right -->
        <DockPanel DockPanel.Dock="Top" Background="#E3F2FD">
            <Button DockPanel.Dock="Right"
                    Content="⚠ Wyślij raport o błędzie"
                    Command="{Binding SendTestReportCommand}"
                    Background="#D32F2F" Foreground="White"
                    FontSize="14" Padding="14,6" Margin="8,4"
                    VerticalAlignment="Center"/>

            <Menu Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="8,4">
                <MenuItem Header="Narzędzia">
                    <MenuItem Header="Zmień folder" Command="{Binding ChangeRootFolderCommand}">
                        <MenuItem.Icon><TextBlock Text="📁"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Otwórz folder z danymi" Command="{Binding OpenDataFolderCommand}">
                        <MenuItem.Icon><TextBlock Text="🗂"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="OSOBA">
                    <MenuItem Header="Nowa osoba"
                              Command="{Binding SwitchModeCommand}"
                              CommandParameter="{x:Static vm:AppMode.Add}">
                        <MenuItem.Icon><TextBlock Text="➕"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Edytuj osobę z drzewa" Command="{Binding OpenPersonCommand}">
                        <MenuItem.Icon><TextBlock Text="✎"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Zapisz osobę i dodaj do drzewa" Command="{Binding SaveNewPersonCommand}">
                        <MenuItem.Icon><TextBlock Text="💾"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Zapisz zmiany dla osoby na drzewie" Command="{Binding SaveTreeChangesCommand}">
                        <MenuItem.Icon><TextBlock Text="✔"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="SZKIC">
                    <MenuItem Header="Wczytaj szkic osoby" Command="{Binding LoadDraftCommand}">
                        <MenuItem.Icon><TextBlock Text="📂"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Zapisz osobę jako szkic" Command="{Binding SaveAsDraftCommand}">
                        <MenuItem.Icon><TextBlock Text="📝"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Zaktualizuj szkic osoby" Command="{Binding UpdateDraftCommand}">
                        <MenuItem.Icon><TextBlock Text="🔄"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Dodaj szkic osoby do drzewa" Command="{Binding PromoteDraftCommand}">
                        <MenuItem.Icon><TextBlock Text="⬆"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="DRZEWO">
                    <MenuItem Header="Wybierz osobę główną" Command="{Binding SetRootPersonCommand}">
                        <MenuItem.Icon><TextBlock Text="★"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Generuj Drzewo" Command="{Binding GenerateFolderTreeCommand}">
                        <MenuItem.Icon><TextBlock Text="🌳"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Generuj Rody" Command="{Binding GenerateLineageFoldersCommand}">
                        <MenuItem.Icon><TextBlock Text="👪"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sprawdź spójność" Command="{Binding ValidateTreeCommand}">
                        <MenuItem.Icon><TextBlock Text="🔍"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Full-width mode indicator strip -->
        <Border DockPanel.Dock="Top"
                Background="{Binding CurrentMode, Converter={StaticResource ModeToBackgroundBrushConverter}}"
                Padding="22,8">
            <TextBlock Text="{Binding CurrentMode, Converter={StaticResource ModeToLabelConverter}}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#1A237E"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F5F5F5" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="22,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#2E7D32" FontSize="13"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C62828" FontSize="13"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Mode-tinted content area -->
        <Grid Background="{Binding CurrentMode, Converter={StaticResource ModeToBackgroundBrushConverter}}">
            <TabControl Margin="0" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                <TabItem Header="1.  Dane osoby">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <views:PersonDataTab DataContext="{Binding Person}"/>
                            <Separator Margin="32,0" Background="#E0E0E0"/>
                            <views:DatesTab DataContext="{Binding Dates}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="2.  Rodzina">
                    <views:FamilyTab DataContext="{Binding Family}"/>
                </TabItem>
                <TabItem Header="3.  Notatki">
                    <views:NotesTab DataContext="{Binding Notes}"/>
                </TabItem>
            </TabControl>
        </Grid>

    </DockPanel>
</Window>
